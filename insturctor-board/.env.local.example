DATABASE_URL=postgres://course:course@localhost:5452/course
SESSION_SECRET=change-me-to-a-long-random-string

# LiveKit screen broadcast — from this directory run:  docker compose up -d
# Compose runs a single livekit-server with embedded TURN (UDP 3478) and a small
# published relay UDP range 50000–50050 so Docker/WSL does not drop relay traffic.
# If ICE still fails from another machine, point NEXT_PUBLIC_LIVEKIT_URL at this
# host's LAN IP and open the same ports on the firewall.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=classroom
