      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;The lesson adds a check that rejects items with &lt;code&gt;price &amp;lt;= 0&lt;/code&gt; using a 400 response. Why 400 rather than 422?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m03_q10_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m03_q10_a0">
              <material><mattext texttype="text/html">400 signals a violation of your own business rules, while FastAPI reserves 422 for Pydantic's structural validation errors</mattext></material>
            </response_label>
            <response_label ident="quiz_m03_q10_a1">
              <material><mattext texttype="text/html">422 is deprecated in FastAPI and 400 is its replacement</mattext></material>
            </response_label>
            <response_label ident="quiz_m03_q10_a2">
              <material><mattext texttype="text/html">400 makes FastAPI automatically roll back the database transaction</mattext></material>
            </response_label>
            <response_label ident="quiz_m03_q10_a3">
              <material><mattext texttype="text/html">422 responses cannot include a custom &lt;code&gt;detail&lt;/code&gt; message</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m03_q10_resp">quiz_m03_q10_a0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m03_q10_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m03_q10_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;The lesson states that validation errors are always 422 (raised automatically by Pydantic), while 400 Bad Request is for business-rule violations you enforce in your own route code.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
