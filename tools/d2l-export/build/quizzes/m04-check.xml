  <assessment ident="quiz_m04" title="Module 04 Check on Learning — Git and GitHub">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_profile</fieldlabel>
        <fieldentry>cc.exam.v0p1</fieldentry>
      </qtimetadatafield>
      <qtimetadatafield>
        <fieldlabel>qmd_scoretype</fieldlabel>
        <fieldentry>Percentage</fieldentry>
      </qtimetadatafield>
    </qtimetadata>
    <section ident="quiz_m04_root">

    <item ident="quiz_m04_q1" title="Question 1">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;Which command makes new repositories start on a &lt;code&gt;main&lt;/code&gt; branch instead of &lt;code&gt;master&lt;/code&gt;?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q1_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q1_a0">
              <material><mattext texttype="text/html">&lt;code&gt;git config --global init.defaultBranch main&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q1_a1">
              <material><mattext texttype="text/html">&lt;code&gt;git config --global branch.default main&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q1_a2">
              <material><mattext texttype="text/html">&lt;code&gt;git branch --set-default main&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q1_a3">
              <material><mattext texttype="text/html">&lt;code&gt;git init --default-branch main --global&lt;/code&gt;</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q1_resp">quiz_m04_q1_a0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q1_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q1_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;Lesson 01 sets &lt;code&gt;init.defaultBranch&lt;/code&gt; globally so every future &lt;code&gt;git init&lt;/code&gt; starts on &lt;code&gt;main&lt;/code&gt;.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q2" title="Question 2">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;You edited &lt;code&gt;main.py&lt;/code&gt;, ran &lt;code&gt;git commit -m &amp;quot;update&amp;quot;&lt;/code&gt;, and Git reported nothing was committed. What step did you skip?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q2_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q2_a0">
              <material><mattext texttype="text/html">Running &lt;code&gt;git push&lt;/code&gt; before committing</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q2_a1">
              <material><mattext texttype="text/html">Staging the change with &lt;code&gt;git add main.py&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q2_a2">
              <material><mattext texttype="text/html">Re-running &lt;code&gt;git init&lt;/code&gt; in the project</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q2_a3">
              <material><mattext texttype="text/html">Setting &lt;code&gt;color.ui&lt;/code&gt; to &lt;code&gt;auto&lt;/code&gt; first</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q2_resp">quiz_m04_q2_a1</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q2_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q2_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;Changes must be staged with &lt;code&gt;git add&lt;/code&gt; before &lt;code&gt;git commit&lt;/code&gt; will include them — that is the core status / add / commit cycle.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q3" title="Question 3">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;You created a brand-new file &lt;code&gt;NOTES.md&lt;/code&gt; and ran &lt;code&gt;git commit -am &amp;quot;Add notes file&amp;quot;&lt;/code&gt;. What happens?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q3_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q3_a0">
              <material><mattext texttype="text/html">The file is committed along with any tracked changes</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q3_a1">
              <material><mattext texttype="text/html">The file is staged but the commit is aborted</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q3_a2">
              <material><mattext texttype="text/html">Nothing is committed — &lt;code&gt;-am&lt;/code&gt; only stages files Git already tracks, so untracked files are skipped</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q3_a3">
              <material><mattext texttype="text/html">Git prompts you to confirm adding the new file</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q3_resp">quiz_m04_q3_a2</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q3_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q3_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;Lesson 03 demonstrates that &lt;code&gt;-am&lt;/code&gt; silently ignores untracked files, which still need a plain &lt;code&gt;git add&lt;/code&gt; first.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q4" title="Question 4">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;After running &lt;code&gt;git add routers/items.py&lt;/code&gt;, plain &lt;code&gt;git diff&lt;/code&gt; shows no output. Which command shows the staged change?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q4_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q4_a0">
              <material><mattext texttype="text/html">&lt;code&gt;git diff --all&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q4_a1">
              <material><mattext texttype="text/html">&lt;code&gt;git log -p&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q4_a2">
              <material><mattext texttype="text/html">&lt;code&gt;git show HEAD&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q4_a3">
              <material><mattext texttype="text/html">&lt;code&gt;git diff --staged&lt;/code&gt;</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q4_resp">quiz_m04_q4_a3</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q4_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q4_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;Plain &lt;code&gt;git diff&lt;/code&gt; shows only unstaged working-tree changes; &lt;code&gt;git diff --staged&lt;/code&gt; shows what is about to be committed.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q5" title="Question 5">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;When you merged &lt;code&gt;add-health-route&lt;/code&gt; into &lt;code&gt;main&lt;/code&gt;, Git reported &amp;quot;Fast-forward&amp;quot;. What does that mean?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q5_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q5_a0">
              <material><mattext texttype="text/html">&lt;code&gt;main&lt;/code&gt; had no commits of its own since the branch diverged, so Git just moved the &lt;code&gt;main&lt;/code&gt; pointer forward with no merge commit</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q5_a1">
              <material><mattext texttype="text/html">Git squashed the branch's commits into a single new commit</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q5_a2">
              <material><mattext texttype="text/html">Git created a merge commit with two parent commits</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q5_a3">
              <material><mattext texttype="text/html">Git replayed the branch's commits on top of &lt;code&gt;main&lt;/code&gt; one at a time</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q5_resp">quiz_m04_q5_a0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q5_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q5_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;A fast-forward happens when &lt;code&gt;main&lt;/code&gt; hasn't diverged, so Git can simply advance the branch pointer without creating a merge commit.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q6" title="Question 6">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;You made an edit to &lt;code&gt;main.py&lt;/code&gt; that you don't want to keep, and it is not staged. Which command discards it?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q6_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q6_a0">
              <material><mattext texttype="text/html">&lt;code&gt;git reset --soft HEAD&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q6_a1">
              <material><mattext texttype="text/html">&lt;code&gt;git restore main.py&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q6_a2">
              <material><mattext texttype="text/html">&lt;code&gt;git restore --staged main.py&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q6_a3">
              <material><mattext texttype="text/html">&lt;code&gt;git commit --amend --no-edit&lt;/code&gt;</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q6_resp">quiz_m04_q6_a1</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q6_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q6_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;&lt;code&gt;git restore &amp;lt;file&amp;gt;&lt;/code&gt; reverts a working-tree file to the version in the latest commit, which is the fix for an unwanted unstaged edit.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q7" title="Question 7">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;A &lt;code&gt;git pull&lt;/code&gt; left &lt;code&gt;NOTES.md&lt;/code&gt; with &lt;code&gt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&lt;/code&gt;, &lt;code&gt;=======&lt;/code&gt;, and &lt;code&gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&lt;/code&gt; markers. What is the correct way to finish the merge?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q7_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q7_a0">
              <material><mattext texttype="text/html">Run &lt;code&gt;git merge --continue&lt;/code&gt; and let Git pick a side automatically</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q7_a1">
              <material><mattext texttype="text/html">Run &lt;code&gt;git push --force&lt;/code&gt; so your version wins</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q7_a2">
              <material><mattext texttype="text/html">Edit the file to the final content, delete all the markers, then &lt;code&gt;git add NOTES.md&lt;/code&gt; and &lt;code&gt;git commit&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q7_a3">
              <material><mattext texttype="text/html">Delete &lt;code&gt;NOTES.md&lt;/code&gt; and run &lt;code&gt;git pull&lt;/code&gt; again</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q7_resp">quiz_m04_q7_a2</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q7_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q7_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;Lesson 09 has you hand-edit the conflicted file, remove every marker, stage it with &lt;code&gt;git add&lt;/code&gt;, and commit to conclude the merge.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q8" title="Question 8">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;When registering an SSH key with GitHub, what do you paste into Settings, SSH / GPG Keys?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q8_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q8_a0">
              <material><mattext texttype="text/html">The contents of &lt;code&gt;~/.ssh/id_ed25519&lt;/code&gt; (the private key)</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q8_a1">
              <material><mattext texttype="text/html">The contents of &lt;code&gt;~/.ssh/known_hosts&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q8_a2">
              <material><mattext texttype="text/html">The contents of &lt;code&gt;~/.gitconfig&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q8_a3">
              <material><mattext texttype="text/html">The contents of &lt;code&gt;~/.ssh/id_ed25519.pub&lt;/code&gt; (the public key)</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q8_resp">quiz_m04_q8_a3</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q8_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q8_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;Only the public &lt;code&gt;.pub&lt;/code&gt; key is uploaded to GitHub; the private key never leaves your machine.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q9" title="Question 9">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;Why do the lessons use &lt;code&gt;git push -u origin main&lt;/code&gt; for the first push of a branch?&lt;/p&gt;</mattext></material>
        <response_lid ident="quiz_m04_q9_resp" rcardinality="Single">
          <render_choice>
            <response_label ident="quiz_m04_q9_a0">
              <material><mattext texttype="text/html">The &lt;code&gt;-u&lt;/code&gt; sets the upstream tracking branch, so later pushes and pulls work with plain &lt;code&gt;git push&lt;/code&gt; and &lt;code&gt;git pull&lt;/code&gt;</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q9_a1">
              <material><mattext texttype="text/html">The &lt;code&gt;-u&lt;/code&gt; forces the push, overwriting any commits on the remote</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q9_a2">
              <material><mattext texttype="text/html">The &lt;code&gt;-u&lt;/code&gt; pushes every local branch at once</mattext></material>
            </response_label>
            <response_label ident="quiz_m04_q9_a3">
              <material><mattext texttype="text/html">The &lt;code&gt;-u&lt;/code&gt; uploads untracked files along with the commits</mattext></material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="quiz_m04_q9_resp">quiz_m04_q9_a0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
          <displayfeedback feedbacktype="Response" linkrefid="quiz_m04_q9_fb" />
        </respcondition>
      </resprocessing>
      <itemfeedback ident="quiz_m04_q9_fb">
        <flow_mat><material><mattext texttype="text/html">&lt;p&gt;&lt;code&gt;-u&lt;/code&gt; links the local branch to &lt;code&gt;origin/&amp;lt;branch&amp;gt;&lt;/code&gt; so Git knows where to push and pull afterward without extra arguments.&lt;/p&gt;</mattext></material></flow_mat>
      </itemfeedback>
    </item>

    <item ident="quiz_m04_q10" title="Question 10">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>cc_profile</fieldlabel>
            <fieldentry>cc.multiple_choice.v0p1</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material><mattext texttype="text/html">&lt;p&gt;Your &lt;code&gt;git push&lt;/code&gt; is rejected with &amp;quot;the remote contains work that you do not have locally.&amp;quot; What do the lessons say to do?&lt;/p&gt;</mattext></material>
