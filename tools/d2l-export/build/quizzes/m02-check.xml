  <assessment ident="quiz_m02" title="Module 02 Check on Learning — Docker Installation and First Containers">
    <qtimetadata>
      <qtimetadatafield>
        <fieldlabel>cc_profile</fieldlabel>
        <fieldentry>cc.exam.v0p1</fieldentry>
      </qtimetadatafield>
